PORT=3000

# Real use / formal demos should keep DEMO_MODE=false.
# Only set DEMO_MODE=true when you intentionally want local demo fallback data.
DEMO_MODE=false

# Recommended: use DeepSeek through the OpenAI-compatible client.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternative: use OpenAI directly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: Feishu bot / webhook integration.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
